# Ghostty Terminal Configuration

# Font Configuration
# A Nerd Font gives the icons that Neovim and the Claude Code statusline use.
# Install it with: brew install --cask font-jetbrains-mono-nerd-font
# This is the family name that Ghostty reports, not the cask name.
font-family = "JetBrainsMono Nerd Font Mono"

# Font size
font-size = 12

# Theme
theme = Catppuccin Frappe
macos-titlebar-style = tabs

# Shell integration
shell-integration = zsh
shell-integration-features = sudo,cursor

# Cursor
cursor-style = block
cursor-style-blink = true

# Window
window-padding-x = 4
window-padding-y = 4

# Performance
# Ghostty is already optimized for performance with Neovim
